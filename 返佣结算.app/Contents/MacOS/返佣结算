#!/bin/zsh
set -u
umask 077
PROJECT_DIR="${0:A:h:h:h:h}"
CHECK_ONLY="${1:-}"

show_error() {
  print -u2 -r -- "$1"
  # --check is non-interactive, including on failure.
  if [[ "$CHECK_ONLY" == "--check" ]]; then
    return
  fi
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run argv
    display alert "返佣结算启动失败" message (item 1 of argv) as critical buttons {"好"} default button "好"
end run
APPLESCRIPT
}

cd -- "$PROJECT_DIR" || {
  show_error "无法访问项目文件夹：$PROJECT_DIR。请检查文件夹访问权限。"
  exit 1
}

if [[ ! -f "$PROJECT_DIR/app.py" ]]; then
  show_error "找不到 app.py。请将‘返佣结算.app’放回项目文件夹，不要单独移走 App。"
  exit 1
fi

if [[ ! -x "$PROJECT_DIR/.venv/bin/python" ]]; then
  show_error "缺少 Python 运行环境。请在项目目录执行：
python3 -m venv .venv
.venv/bin/python -m pip install -r requirements.txt"
  exit 1
fi

if [[ "$CHECK_ONLY" == "--check" ]]; then
  if "$PROJECT_DIR/.venv/bin/python" -c 'import app, rebate_engine, exporter, worker, openpyxl; print("返佣结算启动环境正常")'; then
    exit 0
  fi
  show_error "启动环境检查失败，请根据上面的错误修复。在项目目录同步依赖：
.venv/bin/python -m pip install -r requirements.txt"
  exit 1
fi

LOG_DIR="$PROJECT_DIR/artifacts"
LOG_FILE="$LOG_DIR/launcher.log"
if ! mkdir -p -- "$LOG_DIR" || ! touch -- "$LOG_FILE"; then
  show_error "无法写入启动日志：$LOG_FILE。请检查项目文件夹的写入及访问权限。"
  exit 1
fi

# Wait for Python so crashes can be reported; Finder still opens no Terminal.
"$PROJECT_DIR/.venv/bin/python" -u "$PROJECT_DIR/app.py" "$@" >>"$LOG_FILE" 2>&1
LAUNCH_STATUS=$?
if (( LAUNCH_STATUS != 0 )); then
  show_error "程序启动或运行失败（退出码 $LAUNCH_STATUS）。错误日志：$LOG_FILE
若刚更新过代码，请在项目目录同步依赖：
.venv/bin/python -m pip install -r requirements.txt"
fi
exit "$LAUNCH_STATUS"
