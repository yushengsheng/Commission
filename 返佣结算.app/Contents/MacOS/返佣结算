#!/bin/zsh
set -eu
PROJECT_DIR="${0:A:h:h:h:h}"

show_error() {
  print -u2 -r -- "$1"
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run argv
    display alert "返佣结算启动失败" message (item 1 of argv) as critical buttons {"好"} default button "好"
end run
APPLESCRIPT
}

cd -- "$PROJECT_DIR" || exit 1

# 自动化环境检查支持
if [[ "${1:-}" == "--check" ]]; then
  exec "$PROJECT_DIR/.venv/bin/python" -c 'import app, rebate_engine, exporter, worker; print("返佣结算启动环境正常")'
fi

# 确定运行目录
# 若当前处于受限的 Downloads 目录，优先使用 ~/.local/share/Commission 运行，彻底规避 TCC 限制
RUNTIME_DIR="$PROJECT_DIR"
if [[ "$PROJECT_DIR" == "$HOME/Downloads"* ]]; then
  TARGET_DIR="$HOME/.local/share/Commission"
  mkdir -p "$TARGET_DIR" 2>/dev/null || true
  # 同步最新代码至本地运行目录（排除虚拟环境）
  rsync -a --update \
    --exclude ".git" \
    --exclude "artifacts" \
    --exclude ".venv" \
    --exclude "__pycache__" \
    --exclude ".pytest_cache" \
    "$PROJECT_DIR/" "$TARGET_DIR/" 2>/dev/null || true

  # 若目标目录尚无虚拟环境，复制或链接已有环境
  if [[ ! -x "$TARGET_DIR/.venv/bin/python" && -d "$PROJECT_DIR/.venv" ]]; then
    cp -R "$PROJECT_DIR/.venv" "$TARGET_DIR/.venv" 2>/dev/null || true
  fi
  RUNTIME_DIR="$TARGET_DIR"
fi

if [[ ! -f "$RUNTIME_DIR/app.py" ]]; then
  show_error "找不到 app.py 文件。"
  exit 1
fi

if [[ ! -x "$RUNTIME_DIR/.venv/bin/python" ]]; then
  show_error "缺少 Python 运行环境。请按照项目 README.md 的启动说明恢复 .venv 环境。"
  exit 1
fi

LOG_DIR="$RUNTIME_DIR/artifacts"
mkdir -p -- "$LOG_DIR" 2>/dev/null || true
LOG_FILE="$LOG_DIR/launcher.log"

cd -- "$RUNTIME_DIR" || exit 1

# 纯原生启动 Python GUI 进程，完全不打开任何终端窗口
exec "$RUNTIME_DIR/.venv/bin/python" -u "$RUNTIME_DIR/app.py" "$@" >>"$LOG_FILE" 2>&1
